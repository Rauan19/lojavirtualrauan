# ============================================================
#  API da Vendira — copie para .env e preencha
#  Campos marcados [PROD] são obrigatórios em produção.
# ============================================================

# ---------- Servidor ----------
NODE_ENV="development"            # production no VPS
PORT=3001
PUBLIC_URL="https://sua-api.exemplo.com"   # [PROD] endereço público da API, sem /api (ngrok em dev)
FRONTEND_URL="http://localhost:3000"       # [PROD] endereço do site (links dos e-mails)
FRONTEND_PUBLIC_URL=""                     # opcional: túnel do site em dev
CORS_ORIGINS="http://localhost:3000"       # [PROD] sites que podem chamar a API, separados por vírgula
BODY_LIMIT="1mb"
UPLOAD_DIR="uploads"
PLATFORM_BRAND_NAME="Vendira"

# ---------- Banco de dados ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lojavirtual?schema=public"

# ---------- Segurança ----------
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo"   # [PROD] mínimo 32 caracteres
JWT_EXPIRES_IN="7d"
# Cifra os tokens das lojas no banco. Gerar com randomBytes(32). Perder = perder os tokens.
ENCRYPTION_KEY=""                          # [PROD]

# ---------- Super Admin (criado pelo seed) ----------
SUPER_ADMIN_EMAIL="admin@plataforma.com"
SUPER_ADMIN_PASSWORD="troque-senha-forte"
SUPER_ADMIN_NAME="Super Admin"

# ---------- Cadastro e cobrança da mensalidade ----------
TRIAL_DAYS="7"                   # padrão; o Super Admin pode mudar
BILLING_GRACE_DAYS="7"           # dias de atraso até suspender a loja
SIGNUP_RATE_LIMIT_PER_HOUR="5"   # lojas novas por IP por hora

# ---------- Mercado Pago da plataforma (mensalidades) ----------
# Preferência: configurar no Super Admin. Aqui é só reserva.
PLATFORM_MP_ACCESS_TOKEN=""
PLATFORM_MP_PUBLIC_KEY=""
PLATFORM_MP_TEST_PAYER_EMAIL=""  # comprador de teste, só em sandbox

# ---------- Mercado Pago: "Conectar com Mercado Pago" das lojas (split) ----------
# Client ID/Secret: Suas integrações → app → Credenciais de produção.
# Nunca compartilhe o Client Secret; se vazar, renove no painel.
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_OAUTH_REDIRECT_URI=""         # vazio = {PUBLIC_URL}/api/payments/mercadopago/oauth/callback
MP_OAUTH_TEST="false"            # true = conectar conta de vendedor de TESTE

# ---------- Webhooks ----------
# Mercado Pago: {PUBLIC_URL}/api/payments/webhooks/mercadopago?secret=...
MP_WEBHOOK_SECRET="troque-este-segredo"    # [PROD]
# Melhor Envio: {PUBLIC_URL}/api/shipping/webhooks/melhor-envio?secret=...
ME_WEBHOOK_SECRET="troque-este-segredo"    # [PROD] se usar Melhor Envio

# ---------- Melhor Envio: app OAuth (Integrações → Área do desenvolvedor) ----------
ME_CLIENT_ID=""
ME_CLIENT_SECRET=""
ME_REDIRECT_URI=""
ME_SANDBOX_CLIENT_ID=""
ME_SANDBOX_CLIENT_SECRET=""
ME_SANDBOX_REDIRECT_URI=""

# ---------- E-mail (confirmações e recuperação de senha) ----------
SMTP_HOST=""                     # [PROD]
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vendira <noreply@seudominio.com.br>"

# ---------- Monitoramento de erros (Sentry, opcional) ----------
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"
SENTRY_RELEASE=""

# ---------- Impressora térmica ----------
PRINTER_ALLOW_PRIVATE_NETWORK="false"   # true só se a API estiver na mesma rede da impressora
