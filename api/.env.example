DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lojavirtual?schema=public"
JWT_SECRET="troque-este-segredo-em-producao"

# Cifra os tokens de gateway no banco (Mercado Pago, frete, NFe).
# OBRIGATÓRIO em produção — sem isso um dump do Postgres entrega credencial
# que movimenta dinheiro das lojas. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde fora do banco. Perder a chave = perder os tokens salvos.
# Depois de definir, rode uma vez: npx tsx scripts/encrypt-secrets.ts
ENCRYPTION_KEY=""
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV="development"
UPLOAD_DIR="uploads"

# URL pública da API (sem /api no final). Produção: https://api.seudominio.com
# Localhost não recebe webhook do Mercado Pago — use ngrok ou URL pública.
PUBLIC_URL="https://sua-api-publica.exemplo.com"

# URL do front (links de e-mail: reset senha admin / clientes sem domínio próprio)
FRONTEND_URL="http://localhost:3000"
# Opcional em local: túnel do Next. Sem isso, assinatura usa PUBLIC_URL/api/billing/return
# FRONTEND_PUBLIC_URL=""

# Origens do front da plataforma (vírgula). Domínios custom das lojas liberam sozinhos.
# Em produção NÃO deixe vazio sem FRONTEND_URL na lista.
CORS_ORIGINS="http://localhost:3000"

BODY_LIMIT="1mb"

# Régua de cobrança: dias entre o vencimento da mensalidade e a SUSPENSÃO da loja.
# Vencido = PAST_DUE (painel somente leitura, vitrine continua vendendo).
# Vencido + estes dias = SUSPENDED (loja inteira fora do ar). Padrão: 7.
BILLING_GRACE_DAYS="7"

# Impressora de rede: por padrão o servidor recusa host privado/loopback
# (senão o campo vira scanner da rede interna da VPS + metadata da cloud).
# Só ligue se a API roda na MESMA rede local da impressora.
PRINTER_ALLOW_PRIVATE_NETWORK="false"

# Sentry: sem isso, erro em produção só aparece no log do servidor e
# ninguém é avisado. Crie um projeto Node em sentry.io e cole o DSN.
# Deixando vazio, o Sentry simplesmente não é inicializado (sem custo em dev).
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"
# Preenchido automaticamente pelo seu CI/deploy, se tiver (ex.: hash do commit)
SENTRY_RELEASE=""

# Signup público (sem login). Sem captcha nesta versão — esse limite é a
# única barreira contra criação de lojas em massa.
SIGNUP_RATE_LIMIT_PER_HOUR="5"
# Duração do trial criado no signup público.
TRIAL_DAYS="14"

# Webhook MP — OBRIGATÓRIO em produção
# URL pedidos: {PUBLIC_URL}/api/payments/webhooks/mercadopago?secret={MP_WEBHOOK_SECRET}
# URL mensalidade SaaS: {PUBLIC_URL}/api/billing/webhooks/mercadopago?secret={MP_WEBHOOK_SECRET}
MP_WEBHOOK_SECRET="troque-este-segredo-do-webhook"

# Credenciais MP da PLATAFORMA — preferência: Super Admin no painel.
# .env só como fallback se o banco estiver vazio.
PLATFORM_MP_ACCESS_TOKEN=""
PLATFORM_MP_PUBLIC_KEY=""
# Webhook recorrência: {PUBLIC_URL}/api/billing/webhooks/mercadopago?secret={MP_WEBHOOK_SECRET}
# (URL também aparece no Super Admin)

# Webhook Melhor Envio — OBRIGATÓRIO em produção se usar ME
# URL: {PUBLIC_URL}/api/shipping/webhooks/melhor-envio?secret={ME_WEBHOOK_SECRET}
ME_WEBHOOK_SECRET="troque-segredo-melhor-envio"

# E-mail (recuperação de senha). Sem SMTP em prod = reset não envia.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Loja <noreply@seudominio.com>"

SUPER_ADMIN_EMAIL="admin@plataforma.com"
SUPER_ADMIN_PASSWORD="troque-senha-forte"
SUPER_ADMIN_NAME="Super Admin"
