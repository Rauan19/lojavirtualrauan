generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  STORE_ADMIN
  CUSTOMER
}

enum StoreStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  TRIAL
}

enum StoreType {
  FASHION
  SHOES
  ELECTRONICS
  GENERAL
  CUSTOM
}

enum SellerDocType {
  CPF
  CNPJ
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum InvoiceStatus {
  DRAFT
  PENDING
  AUTHORIZED
  CANCELLED
  REJECTED
  ERROR
}

enum InvoiceModel {
  NFCE
  NFE
}

model Store {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  customDomain     String?     @unique
  logoUrl          String?
  primaryColor     String      @default("#111111")
  secondaryColor   String      @default("#ffffff")
  accentColor      String      @default("#e11d48")
  status           StoreStatus @default(TRIAL)
  planName         String      @default("basic")
  planDueAt        DateTime?
  monthlyFee       Decimal?    @db.Decimal(10, 2)
  /** Assinatura recorrente MP (mensalidade da plataforma). */
  mpPreapprovalId  String?
  mpSubscriptionStatus String? // pending | authorized | paused | cancelled
  /**
   * Como o lojista paga a mensalidade: CARD (recorrência do Mercado Pago,
   * que cobra sozinho) ou PIX (cobrança avulsa gerada por nós a cada ciclo).
   * Pix recorrente não existe na API do MP — por isso o ciclo é nosso.
   */
  billingMethod    String?     @default("CARD")
  storeType        StoreType   @default(GENERAL)

  // Identidade do lojista (PF = CPF ou PJ = CNPJ)
  sellerDocType    SellerDocType?
  sellerDocument   String? // só dígitos
  sellerLegalName  String? // nome completo ou razão social
  sellerTradeName  String? // nome fantasia
  sellerIe         String? // inscrição estadual ou ISENTO

  /**
   * Aceite dos Termos de Uso e da Política de Privacidade no cadastro.
   * Prova do contrato: qual versão, quando e de qual IP. Loja criada antes
   * disso fica null (aceite será pedido de novo quando houver nova versão).
   */
  termsVersion     String?
  termsAcceptedAt  DateTime?
  termsAcceptedIp  String?
  sellerIm         String? // inscrição municipal
  sellerPhone      String?
  sellerEmail      String?
  sellerZipCode    String?
  sellerStreet     String?
  sellerNumber     String?
  sellerComplement String?
  sellerNeighborhood String?
  sellerCity       String?
  sellerState      String? // UF

  // Políticas (HTML/markdown simples)
  termsHtml        String?     @db.Text
  privacyHtml      String?     @db.Text
  returnsHtml      String?     @db.Text

  // Redes sociais (exibidas no rodapé da loja)
  instagramUrl     String?
  facebookUrl      String?
  tiktokUrl        String?

  // NFe / NFC-e (Focus NFe ou provedor compatível)
  nfeEnabled       Boolean     @default(false)
  nfeProvider      String?     @default("focusnfe")
  nfeApiToken      String?
  nfeEnvironment   String      @default("homologacao") // homologacao | producao
  nfeSeries        String      @default("1")
  nfeNextNumber    Int         @default(1)
  nfeCscId         String? // token CSC id (NFC-e)
  nfeCscToken      String?

  mpAccessToken    String?
  mpPublicKey      String?
  /**
   * Conexão pelo "Conectar com Mercado Pago" (OAuth do app da Vendira). Com
   * ela a plataforma pode cobrar comissão por venda (split). Loja com token
   * colado na mão fica com estes campos nulos.
   * mpAccessToken acima continua sendo o token usado nos pagamentos.
   */
  mpRefreshToken   String?
  mpTokenExpiresAt DateTime?
  /** user_id da conta Mercado Pago que autorizou. */
  mpUserId         String?
  mpConnectedAt    DateTime?
  /** false = conectou uma conta de teste (sandbox). */
  mpLiveMode       Boolean?
  checkoutMode     String      @default("personalized")
  /// Desconto para quem paga no Pix, em % sobre os produtos (0 = sem desconto)
  pixDiscountPercent Decimal   @default(0) @db.Decimal(5, 2)
  /// Lembrete automático por e-mail para pedido que expirou sem pagamento
  abandonedCartEmail Boolean   @default(true)
  freteModo        String      @default("manual")
  freteValorFixo   Decimal?    @db.Decimal(10, 2)
  freteGratisAcima Decimal?    @db.Decimal(10, 2)
  freteToken       String?
  freteCepOrigem   String?
  freteRuaOrigem   String?
  freteNumeroOrigem String?
  freteComplementoOrigem String?
  freteBairroOrigem String?
  freteCidadeOrigem String?
  freteUfOrigem    String?
  freteSandbox     Boolean     @default(false)
  /**
   * OAuth do Melhor Envio. O access token vale 30 dias e o refresh, 45 — sem
   * renovação automática o frete de cada loja para de cotar um mês depois de
   * configurado, em silêncio. `freteToken` continua guardando o access token
   * (cifrado, como quando era colado na mão); estes campos são o que permite
   * renovar sozinho e mostrar a conta conectada em vez de um token cru.
   */
  freteRefreshToken   String?
  freteTokenExpiresAt DateTime?
  freteContaNome      String?
  freteContaEmail     String?
  freteEmailContato String?
  /**
   * Gera e paga a etiqueta no Melhor Envio sozinho quando o pagamento é
   * aprovado. Desligado por padrão: consome saldo real da conta do lojista.
   */
  freteEtiquetaAuto Boolean    @default(false)
  /** Nomes/slugs das transportadoras liberadas no checkout (ex.: ["correios","jadlog"]). Vazio = todas. */
  freteTransportadoras Json?
  printerType      String      @default("BROWSER")
  printerHost      String?
  printerPort      Int         @default(9100)
  printerName      String?
  printerAutoPrint Boolean     @default(false)
  printerPaperWidth Int        @default(80)
  /** Desligado por padrão. NÃO usar dias — entrega vem do rastreio real. */
  autoDeliverDays   Int         @default(0)
  marqueeEnabled   Boolean     @default(true)
  marqueeImages    Json?
  /// Versão para celular de cada banner: { [imagem do computador]: imagem do celular }
  marqueeMobile    Json?

  /**
   * Aparência da vitrine. Nulo = herda o preset do storeType, então trocar o
   * ramo da loja já muda a cara dela. Preenchido = o lojista escolheu na mão
   * e a escolha dele manda.
   */
  storeFont        String?
  storeCardRatio   String?
  /** Chave do Template em uso na vitrine. Nulo = Essencial. */
  storeTheme       String?

  /**
   * Sequência do número do pedido. Antes o número saía de count(*) + 1, o
   * que dava o mesmo valor para dois checkouts simultâneos: a constraint
   * única derrubava um dos clientes no último passo da compra.
   */
  orderSeq         Int         @default(0)

  /*
   * Medição de audiência. São opcionais e ficam vazios por padrão: enquanto
   * não houver nenhum configurado, a loja só usa cookie essencial de sessão e
   * o aviso de cookies nem aparece — banner que pede consentimento para nada
   * só ensina o visitante a clicar em "aceitar" sem ler.
   */
  analyticsGaId     String?
  analyticsPixelId  String?

  /**
   * Alertas antifraude do cadastro, para revisão no Super Admin. Ex.:
   * "cnpj_nao_verificado" (Receita fora do ar no cadastro) e
   * "documento_mp_diferente" (CPF/CNPJ da conta do Mercado Pago conectada
   * não bate com o da loja). Não bloqueiam a loja sozinhos.
   */
  alertasCadastro   String[]    @default([])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  users             User[]
  templateCompras   TemplateCompra[]
  categories        Category[]
  products          Product[]
  orders            Order[]
  customers         Customer[]
  coupons           Coupon[]
  promotions        Promotion[]
  invoices          Invoice[]
  platformInvoices  PlatformInvoice[]
  platformFeeEntries PlatformFeeEntry[]
  stockAlerts        StockAlert[]
  /**
   * Comissão por venda nesta loja: null segue o geral (PLATFORM_FEE_ENABLED),
   * true/false força. Serve para ligar aos poucos e desligar na hora.
   */
  platformFeeEnabled Boolean?
  reviews           Review[]
  favorites         Favorite[]

  /** Um teste grátis por CPF/CNPJ: o cadastro procura a loja pelo documento */
  @@index([sellerDocument])
}

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  name         String
  role         Role
  storeId      String?
  active       Boolean  @default(true)
  /** Invalida tokens JWT antigos ao trocar senha / desativar conta. */
  tokenVersion Int      @default(0)
  /// Dono da loja (acesso total). Funcionário convidado = false
  storeOwner   Boolean  @default(true)
  /// Áreas do painel que o funcionário acessa (pedidos, produtos, clientes, marketing, configuracoes)
  permissions  String[] @default([])

  /// Verificação em duas etapas (TOTP). Chaves cifradas como os tokens das lojas.
  totpSecret          String?
  /// Chave gerada na ativação, até o primeiro código confirmar
  totpPendingSecret   String?
  totpEnabledAt       DateTime?
  /// Último passo de 30s aceito: o mesmo código não vale duas vezes
  totpLastStep        Int?
  /// Hash SHA-256 dos códigos de recuperação ainda não usados
  totpRecoveryHashes  String[] @default([])
  /// Erros seguidos no código; ao chegar no limite, bloqueia por um tempo
  totpFailures        Int      @default(0)
  totpLockedUntil     DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@index([email])
}

/*
 * Registro de acesso à aplicação (Marco Civil da Internet, art. 15): provedor
 * de aplicação constituído como pessoa jurídica deve guardar os registros por
 * 6 meses, sob sigilo.
 *
 * É gravado um registro por titular/IP por hora, não por requisição: o que a
 * lei pede é data e hora de uso a partir de um IP, e uma linha por clique
 * inviabilizaria a tabela sem acrescentar nada.
 */
model AccessLog {
  id        String   @id @default(cuid())
  storeId   String?
  /** Cliente da loja, quando autenticado. */
  customerId String?
  /** Usuário do painel, quando autenticado. */
  userId    String?
  ip        String
  userAgent String?
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
}

model Customer {
  id           String   @id @default(cuid())
  storeId      String
  email        String
  passwordHash String?
  name         String
  phone        String?
  cpf          String?
  /** Invalida tokens JWT antigos ao trocar senha. */
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders    Order[]
  addresses Address[]
  reviews   Review[]
  favorites Favorite[]

  @@unique([storeId, email])
  @@index([storeId])
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Category {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  imageUrl    String?
  /**
   * Cor do anel em volta da imagem na vitrine. Nulo = usa a cor de destaque
   * da loja. Importa quando a arte tem fundo transparente: sem o anel, o
   * círculo não tem contorno e a fileira de categorias perde a forma.
   */
  borderColor String?
  parentId    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model Product {
  id           String   @id @default(cuid())
  storeId      String
  categoryId   String?
  name         String
  slug         String
  description  String?
  sku          String?
  brand        String?
  price        Decimal  @db.Decimal(10, 2)
  compareAt    Decimal? @db.Decimal(10, 2)
  installments Int?
  weightKg     Decimal? @db.Decimal(10, 3)
  widthCm      Decimal? @db.Decimal(10, 2)
  heightCm     Decimal? @db.Decimal(10, 2)
  lengthCm     Decimal? @db.Decimal(10, 2)
  stock        Int      @default(0)
  active       Boolean  @default(true)
  featured     Boolean  @default(false)
  attributes   Json? // attrs do nicho { material, potencia, ... }
  hasVariants  Boolean  @default(false)
  ncm          String? // NCM fiscal (8 dígitos)
  cfop         String? // default 5102/5101 etc.
  unit         String   @default("UN")
  /// "Compre junto": até 3 produtos que o lojista sugere levar com este
  buyTogetherIds String[] @default([])
  /// Desconto (%) nos sugeridos quando levados junto com este. 0 = sem desconto
  buyTogetherDiscountPct Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  promotions Promotion[]
  reviews    Review[]
  favorites  Favorite[]
  stockAlerts StockAlert[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, active])
  /** Busca pelo código do produto (sku). */
  @@index([storeId, sku])
}

model Review {
  id               String   @id @default(cuid())
  storeId          String
  productId        String
  customerId       String
  rating           Int
  comment          String?
  hidden           Boolean  @default(false)
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([storeId])
  @@index([productId])
}

model Favorite {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([storeId])
  @@index([customerId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String?
  barcode   String?
  label     String // ex: "M / Preto"
  options   Json // { size: "M", color: "Preto" }
  price     Decimal? @db.Decimal(10, 2) // null = usa preço do produto
  compareAt Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
  weightKg  Decimal? @db.Decimal(10, 3)
  widthCm   Decimal? @db.Decimal(10, 2)
  heightCm  Decimal? @db.Decimal(10, 2)
  lengthCm  Decimal? @db.Decimal(10, 2)
  imageUrl  String?
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@index([productId, active])
}

model Order {
  id                String        @id @default(cuid())
  storeId           String
  customerId        String?
  orderNumber       String
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  subtotal          Decimal       @db.Decimal(10, 2)
  shippingCost      Decimal       @default(0) @db.Decimal(10, 2)
  discount          Decimal       @default(0) @db.Decimal(10, 2)
  total             Decimal       @db.Decimal(10, 2)
  shippingMethod    String?
  /** Id do serviço escolhido na cotação (ex.: "me-1"). Necessário para a etiqueta. */
  shippingServiceId String?
  /** URL do PDF da etiqueta gerada na transportadora. */
  labelUrl          String?
  trackingCode      String?
  trackingUrl       String?
  /** ID etiqueta Melhor Envio — webhook/polling. */
  carrierShipmentId String?
  customerName      String
  customerEmail     String
  customerPhone     String?
  customerDocument  String? // CPF do comprador (NFe)
  shippingAddress   Json?
  mpPreferenceId    String?
  mpPaymentId       String?
  mpRefundId        String?
  couponId          String?
  couponCode        String?
  notes             String?
  paidAt            DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  refundRequestedAt DateTime?
  refundReason      String?
  /**
   * REQUESTED → RETURN_PENDING → APPROVED, ou REQUESTED → APPROVED quando não
   * há o que devolver (extravio), ou REQUESTED → REJECTED.
   */
  refundStatus      String?
  /** ARREPENDIMENTO | DEFEITO | NAO_RECEBI | OUTRO. */
  refundReasonType  String?
  /** Quando o lojista confirmou que o produto voltou de fato. */
  returnReceivedAt  DateTime?
  refundedAt        DateTime?
  /**
   * Como o dinheiro voltou: GATEWAY (estorno disparado por nós), ou
   * GATEWAY_EXTERNAL (o lojista estornou direto no painel do Mercado Pago e
   * ficamos sabendo pelo webhook). Nulo em pedido não estornado — e também
   * nos pedidos antigos, de quando dava para marcar "Reembolsado" na mão sem
   * devolver nada.
   */
  refundVia         String?
  /** Cupom reservado e ainda não devolvido. Espelha stockReserved. */
  couponReserved    Boolean  @default(false)
  /**
   * Momento em que o cliente aceitou as condições de venda no checkout.
   * Decreto 7.962/2013 art. 4º, I exige apresentar o sumário do contrato
   * antes da contratação; guardar o aceite é a prova de que foi apresentado.
   */
  termsAcceptedAt   DateTime?
  /**
   * Estoque baixado na criação do pedido (reserva). Volta ao cancelar,
   * expirar ou estornar. Serve de trava contra devolver estoque 2x.
   */
  stockReserved     Boolean       @default(false)
  /**
   * Comissão da plataforma, fotografada quando a cobrança é criada: mudar a
   * taxa do plano depois não mexe em pedido antigo. Em centavos (inteiro,
   * sem erro de arredondamento). Base = produtos − desconto, sem frete.
   * Nulo = pedido sem comissão (antes do split ou plano sem taxa).
   */
  /// Desconto Pix oferecido neste pedido (calculado na tentativa de Pix)
  pixDiscount       Decimal       @default(0) @db.Decimal(10, 2)
  /// true quando o pagamento confirmou pelo Pix e o desconto entrou no total
  pixDiscountApplied Boolean      @default(false)
  /// Quando o pedido expirou sem pagamento (carrinho abandonado)
  expiredUnpaidAt   DateTime?
  /// Lembrete de carrinho abandonado já enviado (um só por pedido)
  recoveryEmailSentAt DateTime?
  platformFeeBps    Int?
  platformFeeBaseCents Int?
  platformFeeCents  Int?
  /// O que o Mercado Pago de fato reteve (fee_details.application_fee), lido na conciliação
  platformFeeChargedCents Int?
  /// Retido ≠ fotografado: alguém precisa olhar (relatório do Super Admin)
  platformFeeMismatch Boolean @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  platformFeeEntries PlatformFeeEntry[]
  coupon   Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  shipmentEvents ShipmentEvent[]
  invoice  Invoice?

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([storeId, refundStatus])
  @@index([carrierShipmentId])
  @@index([trackingCode])

  @@index([storeId, expiredUnpaidAt])
}

model Coupon {
  id          String       @id @default(cuid())
  storeId     String
  code        String
  description String?
  type        DiscountType @default(PERCENT)
  value       Decimal      @db.Decimal(10, 2)
  minSubtotal Decimal?     @db.Decimal(10, 2)
  maxUses     Int?
  /** Limite por cliente. Nulo = sem limite. */
  maxPerCustomer Int?
  /**
   * Conta reservas, não só usos consumados. O cupom é reservado quando o
   * pedido é criado e devolvido se ele for cancelado, expirar ou ser
   * estornado — mesma mecânica do estoque. Antes só era incrementado na
   * aprovação do pagamento, e um cupom de 10 usos era fechado por 100
   * pessoas ao mesmo tempo, porque a checagem via usedCount ainda em zero.
   */
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean      @default(true)
  /** Lojista escolhe se o cupom aparece num banner na vitrine. */
  showOnStorefront Boolean @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([storeId, active])
}

model Promotion {
  id        String    @id @default(cuid())
  storeId   String
  productId String
  title     String?
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([storeId, active])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  productName  String
  variantLabel String?
  sku          String?
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  total        Decimal @db.Decimal(10, 2)
  attributes   Json?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Invoice {
  id           String        @id @default(cuid())
  storeId      String
  orderId      String        @unique
  model        InvoiceModel  @default(NFCE)
  status       InvoiceStatus @default(DRAFT)
  number       Int?
  series       String?
  accessKey    String?
  protocol     String?
  xmlUrl       String?
  pdfUrl       String?
  providerRef  String?
  errorMessage String?       @db.Text
  issuedAt     DateTime?
  cancelledAt  DateTime?
  payload      Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, status])
}

/** Token de recuperação de senha (cliente ou admin). */
model PasswordResetToken {
  id        String    @id @default(cuid())
  /** CUSTOMER | STORE_ADMIN | SUPER_ADMIN */
  subject   String
  email     String
  storeId   String?
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, storeId])
  @@index([expiresAt])
}

/** Mensalidade SaaS da plataforma (lojista → Vitrine), via Assinatura MP. */
model PlatformInvoice {
  id              String        @id @default(cuid())
  storeId         String
  planId          String
  planName        String
  amount          Decimal       @db.Decimal(10, 2)
  periodDays      Int
  status          PaymentStatus @default(PENDING)
  mpPreferenceId  String?
  mpPreapprovalId String?
  mpPaymentId     String?       @unique
  paidAt          DateTime?
  /** CARD | PIX — como esta fatura específica foi cobrada. */
  method          String        @default("CARD")
  /** Vencimento do ciclo que esta fatura cobre. */
  dueAt           DateTime?
  /** Pix: copia e cola, imagem do QR e validade da cobrança. */
  pixCopiaECola   String?       @db.Text
  pixQrCodeBase64 String?       @db.Text
  pixExpiresAt    DateTime?
  /** Quando o lembrete de vencimento foi enviado — um por fatura. */
  pixLembreteEm   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, status])
  @@index([mpPreferenceId])
  @@index([mpPreapprovalId])
  @@index([storeId, method, status])
}

/** Configuração global da plataforma (singleton id = default). */
/**
 * Template pronto da vitrine. A aparência é a receita em `receita` (ver
 * src/templates/receita.ts); Store.storeTheme guarda a `chave` do template
 * em uso. Inativo some da galeria do lojista, mas quem já usa continua.
 *
 * Venda: `acesso` = gratis | plano | pago. "plano" libera para os planos em
 * `planos` (ids de PlatformPlan); "pago" é venda única por `precoCentavos`
 * (e pode vir incluso em algum plano também).
 */
model Template {
  id            String           @id @default(cuid())
  chave         String           @unique
  nome          String
  paraQuem      String
  descricao     String
  segmentos     String[]         @default([])
  receita       Json
  ativo         Boolean          @default(true)
  ordem         Int              @default(0)
  acesso        String           @default("gratis")
  planos        String[]         @default([])
  precoCentavos Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  compras       TemplateCompra[]
}

/** Template pago que a loja comprou (ou ganhou de cortesia do Super Admin) */
model TemplateCompra {
  id            String   @id @default(cuid())
  templateId    String
  storeId       String
  valorCentavos Int      @default(0)
  /** compra | cortesia */
  origem        String   @default("compra")
  mpPaymentId   String?
  criadoEm      DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([templateId, storeId])
  @@index([storeId])
}

model PlatformSettings {
  id                   String   @id @default("default")
  mpAccessToken        String?
  mpPublicKey          String?
  /** true = credenciais de teste → usar sandbox_init_point. */
  mpUseSandbox         Boolean  @default(true)
  /** E-mail do Comprador de teste (@testuser.com) — obrigatório em sandbox. */
  mpTestPayerEmail     String?
  /** Cache planId:amount → preapproval_plan_id do Mercado Pago. */
  mpPreapprovalPlans   Json?
  /** Dias de teste grátis no signup público. null = usa TRIAL_DAYS do .env (padrão 14). */
  trialDays            Int?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

/** Planos da mensalidade da plataforma — editáveis pelo Super Admin. */
model PlatformPlan {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  amount      Decimal  @db.Decimal(10, 2)
  periodDays  Int      @default(30)
  badge       String?
  highlight   Boolean  @default(false)
  features    Json?
  /**
   * Limites do plano, aplicados de verdade pela API (PlanLimitsService).
   * null = sem limite. Loja em teste grátis não tem limite nenhum.
   */
  maxProducts Int?
  /// Pessoas no painel da loja, contando o dono (null = sem limite)
  maxUsers             Int?
  /** Emissão de NF-e/NFC-e (manual e automática) liberada neste plano. */
  nfeIncluded Boolean  @default(true)
  /**
   * Comissão da plataforma por venda, em pontos-base (200 = 2%). Cobrada pelo
   * split do Mercado Pago (application_fee). 0 = sem comissão.
   */
  feeBps      Int      @default(0)
  /** Permite ligar domínio próprio (www.minhaloja.com.br). */
  customDomainIncluded Boolean @default(true)
  /** Desativado some da lista de escolha, mas não quebra loja que já usa o nome. */
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

/*
 * Ocorrências do rastreio, para o cliente acompanhar sem sair da loja.
 *
 * O Melhor Envio só devolve marcos com data (postado, entregue) — não tem
 * cidade nem trajeto. Quem tem o detalhe é a consulta dos Correios, que já era
 * chamada aqui e tinha os eventos descartados. Guardamos as duas origens: os
 * marcos garantem uma linha do tempo mínima para qualquer transportadora, e os
 * eventos dos Correios preenchem o caminho quando existem.
 */
model ShipmentEvent {
  id          String   @id @default(cuid())
  orderId     String
  /** correios | melhor_envio */
  origem      String
  /** Código do evento na origem (BDE, posted...). Usado para não duplicar. */
  codigo      String
  descricao   String
  cidade      String?
  uf          String?
  ocorridoEm  DateTime
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /*
   * A consulta e o webhook repetem os mesmos eventos a cada rodada; sem isto a
   * linha do tempo do cliente encheria de duplicata.
   */
  @@unique([orderId, origem, codigo, ocorridoEm])
  @@index([orderId, ocorridoEm])
}


enum PlatformFeeEntryType {
  CHARGE
  REFUND
  CHARGEBACK
  ADJUSTMENT
}

/**
 * Livro de comissões da plataforma. Só recebe linhas novas (nunca edita nem
 * apaga): é daqui que saem relatório, conciliação e a base da NFS-e.
 * amountCents é positivo na cobrança e negativo no estorno/chargeback.
 * `idempotencyKey` impede lançar duas vezes o mesmo movimento quando o
 * Mercado Pago reenvia o aviso (ex.: "charge:123", "refund:123:456").
 */
model PlatformFeeEntry {
  id             String               @id @default(cuid())
  storeId        String
  orderId        String?
  type           PlatformFeeEntryType
  amountCents    Int
  mpPaymentId    String?
  idempotencyKey String               @unique
  note           String?
  createdAt      DateTime             @default(now())

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([createdAt])
  @@index([orderId])
}

/** Quem mudou o quê num plano — preço e taxa mexem no dinheiro de todo mundo. */
model PlatformPlanChange {
  id          String   @id @default(cuid())
  planId      String
  changedById String?
  changes     Json
  createdAt   DateTime @default(now())

  @@index([planId, createdAt])
}

/// "Avise-me quando chegar": quem quer saber quando o produto volta ao estoque
model StockAlert {
  id         String    @id @default(cuid())
  storeId    String
  productId  String
  /// "" = produto sem variação (vazio, não nulo, para o índice único valer)
  variantId  String    @default("")
  email      String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, email])
  @@index([notifiedAt, storeId])
}

/// Celular/computador do lojista inscrito para receber "Você vendeu!" (Web Push)
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  storeId    String
  /// URL do serviço de push do navegador (única por aparelho/navegador)
  endpoint   String   @unique
  p256dh     String
  auth       String
  /// "Chrome no Android", para o lojista reconhecer o aparelho
  device     String?
  createdAt  DateTime @default(now())
  lastSentAt DateTime?

  @@index([storeId])
  @@index([userId])
}
