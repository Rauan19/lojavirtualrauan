# ============================================================
#  Site da Vendira (Next.js) — copie para .env.local e preencha
#  Variáveis NEXT_PUBLIC_* entram no build: mudou, rode o build de novo.
# ============================================================

# ---------- Conexão com a API ----------
API_PROXY_TARGET=http://127.0.0.1:3001     # onde a API está rodando
NEXT_PUBLIC_API_ORIGIN=                    # opcional: API em outro domínio
NEXT_PUBLIC_API_URL=                       # opcional: vazio = /api
NEXT_PUBLIC_UPLOADS_URL=                   # opcional: fotos em outro domínio

# ---------- Endereço do site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000       # [PROD] https://seudominio.com.br
PLATFORM_HOSTS=localhost,127.0.0.1               # [PROD] seudominio.com.br,app.seudominio.com.br

# ---------- Página inicial ----------
NEXT_PUBLIC_CONTACT_WHATSAPP=              # ex.: 5511988887777 (vazio esconde o botão)
NEXT_PUBLIC_CONTACT_EMAIL=                 # ex.: contato@seudominio.com.br
DEMO_STORE_SLUG=                           # loja do "ver exemplo ao vivo"
GOOGLE_SITE_VERIFICATION=                  # código do Google Search Console

# ---------- Dados da empresa (Termos, Privacidade e rodapé) ----------
# Preencha quando abrir a ME. Campo vazio não aparece no site.
NEXT_PUBLIC_LEGAL_RAZAO_SOCIAL=            # ex.: Vendira Tecnologia Ltda
NEXT_PUBLIC_LEGAL_CNPJ=                    # ex.: 12.345.678/0001-90
NEXT_PUBLIC_LEGAL_ENDERECO=                # ex.: Rua X, 100, Centro, Salvador/BA, CEP 40000-000
NEXT_PUBLIC_LEGAL_CIDADE_FORO=             # ex.: Salvador/BA
NEXT_PUBLIC_LEGAL_EMAIL_PRIVACIDADE=       # vazio = usa o e-mail de contato

# ---------- Monitoramento de erros (Sentry, opcional) ----------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
