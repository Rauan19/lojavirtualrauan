# API proxy (Nest). Dev: API em 3001, Next em 3000.
API_PROXY_TARGET=http://127.0.0.1:3001

# Hosts da plataforma (não reescrevem para /loja/[slug])
# Produção: app.seudominio.com,seudominio.com
PLATFORM_HOSTS=localhost,127.0.0.1

# URL pública do site da plataforma. Usada no sitemap e nas meta tags
# (link compartilhado no WhatsApp/Instagram). Sem barra no fim.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search Console: codigo da verificacao por tag HTML (so o valor do content).
# Sem isso nao da para submeter o sitemap nem ver por qual busca o site
# aparece. Vazio = a meta tag nao e emitida.
GOOGLE_SITE_VERIFICATION=

# Loja aberta pelo link "Abrir exemplo ao vivo" na landing. Vazio = usa a
# loja ativa mais recente; sem nenhuma loja no ar, o link nao aparece.
DEMO_STORE_SLUG=

# Contato da landing e do suporte no painel.
# Sem WhatsApp definido, os botões simplesmente não aparecem
# (melhor do que mostrar botão que não leva a lugar nenhum).
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Dados da empresa dona da plataforma: aparecem nos Termos de Uso (/termos),
# na Política de Privacidade (/privacidade) e no rodapé da página inicial.
# Preencha quando a ME estiver aberta. Campo vazio não aparece no site (até
# lá mostra só "Vendira"). Depois de mudar, rode o build do site de novo:
# NEXT_PUBLIC_* entra no build.
# Exemplo: "Vendira Tecnologia Ltda"
NEXT_PUBLIC_LEGAL_RAZAO_SOCIAL=
# Exemplo: "12.345.678/0001-90"
NEXT_PUBLIC_LEGAL_CNPJ=
# Endereço da sede, como no cartão CNPJ.
# Exemplo: "Rua das Flores, 100, Centro, Salvador/BA, CEP 40000-000"
NEXT_PUBLIC_LEGAL_ENDERECO=
# Cidade onde um processo sobre os Termos seria julgado (em geral a da sede).
# Exemplo: "Salvador/BA"
NEXT_PUBLIC_LEGAL_CIDADE_FORO=
# E-mail do encarregado de dados (LGPD art. 41), que recebe pedidos de
# acesso, correção e exclusão. Vazio = usa NEXT_PUBLIC_CONTACT_EMAIL.
# Exemplo: "privacidade@seudominio.com.br"
NEXT_PUBLIC_LEGAL_EMAIL_PRIVACIDADE=

# Sentry: sem isso, erro no navegador do cliente ou no server-side rendering
# só aparece pra quem estiver com o console aberto. Vazio = SDK não inicializa.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Só necessários se quiser sourcemap legível no Sentry (opcional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
